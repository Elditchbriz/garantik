# Modèle de configuration locale : copiez ce fichier sous le nom .env (ignoré par Git) et remplissez les valeurs.
# Ne mettez ICI aucune valeur réelle : ce fichier est public. Seules des clés PUBLIQUES vont dans les variables VITE_ (elles sont visibles dans le site).
# Les secrets (clé de service Supabase, clé secrète Stripe, Brevo, Anthropic…) ne vont JAMAIS ici : ils vivent dans les secrets de Supabase et de GitHub.

# Clé d'application Dropbox (publique)
VITE_DROPBOX_APP_KEY=

# Identifiant client Google (web), jamais le secret client
VITE_GOOGLE_CLIENT_ID=

# Identifiant d'application Microsoft (public)
VITE_ONEDRIVE_CLIENT_ID=

# Locataire Microsoft (par exemple « consumers »)
VITE_ONEDRIVE_TENANT=

# Adresse de réception des erreurs Sentry
VITE_SENTRY_DSN=

# Clé PUBLIABLE de Stripe (pk_...), jamais la clé secrète (sk_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# Clé PUBLIQUE de Supabase (anon / publishable), jamais la clé de service
VITE_SUPABASE_ANON_KEY=

# Adresse du projet Supabase (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Fournie AUTOMATIQUEMENT par Vercel à chaque construction (numéro de version envoyé à Sentry) : ne pas la définir.
# VITE_VERCEL_GIT_COMMIT_SHA=
