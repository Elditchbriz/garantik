{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(auth|join-household|reset-password|retractation|suppression-compte|desabonnement)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/legal/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
